{
  # IP clients normally omit SNI; ECS NAT hides the public listener address.
  default_sni {$APP_DOMAIN}
}

{$APP_DOMAIN} {
  tls {
    issuer acme {
      dir {$ACME_DIRECTORY:https://acme-v02.api.letsencrypt.org/directory}
      profile shortlived
    }
  }

  encode zstd gzip
  # Independent offline scoring; keep this route during website upgrades.
  @riichi_score path /riichi /riichi/*
  reverse_proxy @riichi_score yougui-riichi-score:3200
  redir /mahjong /riichi/online/ 302
  redir /mahjong/ /riichi/online/ 302
  @retired_mahjong path /api/mahjong /mahjong/socket.io*
  respond @retired_mahjong "联机麻将已迁移至 /riichi/online/" 410
  reverse_proxy app:3000 {
    header_up X-Yougui-Client-IP {remote_host}
    flush_interval -1
  }

  header {
    X-Content-Type-Options nosniff
    Referrer-Policy strict-origin-when-cross-origin
  }
}
