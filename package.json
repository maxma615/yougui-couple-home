{
  "name": "couple-home",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3000",
    "build": "next build --webpack",
    "start": "next start --hostname 127.0.0.1 --port 3000",
    "migrate": "tsx --env-file-if-exists=.env.local src/cli/migrate.ts",
    "test": "node --env-file-if-exists=.env.local node_modules/vitest/vitest.mjs run",
    "typecheck": "tsc --noEmit",
    "test:e2e": "tsx --env-file-if-exists=.env.local scripts/test-e2e.ts",
    "init-admin": "tsx --env-file-if-exists=.env.local src/cli/init-admin.ts",
    "reset-password": "tsx --env-file-if-exists=.env.local src/cli/reset-password.ts",
    "predev": "npm run migrate",
    "prestart": "npm run migrate",
    "check:secrets": "tsx --env-file-if-exists=.env.local scripts/check-secrets.ts",
    "pg:start": "sh scripts/pg-start",
    "pg:stop": "sh scripts/pg-stop",
    "backup": "tsx --env-file-if-exists=.env.local src/cli/backup.ts",
    "restore": "tsx --env-file-if-exists=.env.local src/cli/restore.ts",
    "verify-storage": "tsx --env-file-if-exists=.env.local src/cli/verify-storage.ts",
    "photo-cleanup": "tsx --env-file-if-exists=.env.local src/cli/cleanup-photos.ts",
    "test:persistence": "tsx --env-file-if-exists=.env.local scripts/test-persistence.ts",
    "check:clean-build": "tsx scripts/check-clean-build.ts"
  },
  "dependencies": {
    "argon2": "0.45.1",
    "drizzle-orm": "0.45.3",
    "lucide-react": "1.47.0",
    "next": "16.3.6",
    "pg": "8.23.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "0.35.4",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "0.31.11",
    "jsdom": "30.1.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  },
  "allowScripts": {
    "argon2@0.45.1": true,
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true
  }
}
